{
  "name": "@certpath/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./security/question-import-cleanup": "./src/security/question-import-cleanup.ts",
    "./security/question-imports": "./src/security/question-imports.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "tsx --test src/index.test.ts && vitest run --config vitest.config.ts",
    "benchmark:local-auth": "vitest run --config vitest.benchmark.config.ts --disableConsoleIntercept benchmark/local-auth-runtime-benchmark.test.ts"
  },
  "dependencies": {
    "@certpath/contracts": "0.0.0",
    "@noble/hashes": "2.0.1",
    "csv-parse": "7.0.3",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "vitest": "^4.1.12"
  }
}
