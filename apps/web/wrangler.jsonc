/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "certpath-foundation",
	"compatibility_date": "2026-11-10",
	"main": "./workers/app.ts",
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"INDEXING_ENABLED": "false",
		"PUBLIC_SITE_ORIGIN": "",
		"AUDIT_RETENTION_ENABLED": "false",
		"COMMERCE_ENABLED": "false",
		"PAYMENT_PROVIDER": "none",
		"PILOT_EVENTS_ENABLED": "false",
		"PILOT_SERVER_EVENTS_ENABLED": "false",
		"PILOT_EVENTS_RETENTION_ENABLED": "false",
		"STAFF_MFA_ALLOWED_METHODS": "totp",
		"STAFF_MFA_MAX_AGE_MS": "28800000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "certpath-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../../db/migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}