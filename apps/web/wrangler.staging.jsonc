{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "learner-auth-staging",
	"compatibility_date": "2026-11-10",
	"main": "./workers/staging-app.ts",
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"INDEXING_ENABLED": "false",
		"PUBLIC_SITE_ORIGIN": "https://learner-auth-staging.certpath.workers.dev",
		"STAFF_MFA_MAX_AGE_MS": "28800000",
		"STAFF_MFA_ALLOWED_METHODS": "totp",
		"STAGING_LEARNER_AUTH_ENABLED": "true",
		"STAGING_LEARNER_EMAIL": "learner@example.test",
		"AWS_REGION": "eu-north-1",
		"LEARNER_GOOGLE_OIDC_ENABLED": "false",
		"GOOGLE_OIDC_CLIENT_ID": "",
		"GOOGLE_OIDC_REDIRECT_URI": "",
		"PILOT_EVENTS_ENABLED": "false",
		"PILOT_SERVER_EVENTS_ENABLED": "false",
		"PILOT_EVENTS_RETENTION_ENABLED": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "certpath-learner-staging",
			"database_id": "c52e398f-4280-40a6-8244-854186dc6ef2",
			"migrations_dir": "../../db/migrations"
		}
	],
	"observability": {
		"enabled": false
	},
	"upload_source_maps": true
}
