{
  "name": "@certpath/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "tsx --test app/lib/seo.test.ts app/lib/prototype-data.test.ts app/lib/practice-flow.test.ts app/components/practice-demo.test.tsx app/components/protected-csv-tools.test.tsx app/routes/admin-question-editor.test.tsx app/components/learner-practice.test.tsx app/components/learner-timed-mock.test.tsx app/components/learner-dashboard.test.tsx app/components/learner-attempt-links.test.tsx",
    "preview": "npm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply certpath-local --local",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "@certpath/api": "0.0.0",
    "@certpath/contracts": "0.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@cloudflare/vite-plugin": "^1.68.0",
    "@react-router/dev": "^8.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.160.0"
  }
}