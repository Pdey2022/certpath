PUBLIC_SITE_ORIGIN=http://localhost:5173
CSRF_HMAC_SECRET=REPLACE_WITH_A_RANDOM_LOCAL_VALUE_OF_AT_LEAST_32_CHARACTERS
LOCAL_AUTH_RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_LOCAL_VALUE_OF_AT_LEAST_32_CHARACTERS
LOCAL_LEARNER_AUTH_ENABLED=false
LOCAL_LEARNER_EMAIL_LINK_ENABLED=false
LOCAL_TEST_MAIL_ENABLED=false
STAFF_MFA_MAX_AGE_MS=900000
STAFF_MFA_ALLOWED_METHODS=tester-gate
STAFF_RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_ANOTHER_RANDOM_LOCAL_VALUE_OF_AT_LEAST_32_CHARACTERS
ADMIN_TESTER_IPS=
ADMIN_TESTER_ASSURANCE=false
ADMIN_TESTER_LOCAL=false
# Commerce is off unless both of these are set deliberately and a webhook secret
# is supplied with `wrangler secret put`. A placeholder is not a secret: the fake
# provider is enabled only in local development, never on a preview or the
# deployed Worker.
COMMERCE_ENABLED=false
PAYMENT_PROVIDER=none
COMMERCE_WEBHOOK_SECRET=REPLACE_WITH_A_LOCAL_ONLY_VALUE_OF_AT_LEAST_32_CHARACTERS
