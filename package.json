{
  "name": "certpath",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @certpath/web",
    "build:staging": "npm run build:staging --workspace @certpath/web",
    "build:site": "npm run build:site --workspace @certpath/web",
    "deploy:site": "npm run deploy:site --workspace @certpath/web",
    "build:pilot": "npm run build:pilot --workspace @certpath/web",
    "deploy:pilot": "npm run deploy:pilot --workspace @certpath/web",
    "dry-run:pilot": "npm run dry-run:pilot --workspace @certpath/web",
    "learner:provision": "node apps/api/scripts/provision-learner-sign-in-invite.mjs",
    "staff:provision": "tsx apps/api/scripts/provision-staff-accounts.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate:local": "npm run db:migrate:local --workspace @certpath/web",
    "benchmark:lambda:package": "npm run benchmark:lambda:package --workspace @certpath/api",
    "benchmark:lambda": "npm run benchmark:lambda --workspace @certpath/api",
    "verify": "npm run typecheck && npm test && npm run build"
  }
}
