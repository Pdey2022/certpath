{
  "name": "certpath",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "tsx": "4.23.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @certpath/web",
    "build:staging": "npm run build:staging --workspace @certpath/web",
    "build:site": "npm run build:site --workspace @certpath/web",
    "deploy:site": "npm run deploy:site --workspace @certpath/web",
    "build:pilot": "npm run build:pilot --workspace @certpath/web",
    "deploy:pilot": "npm run deploy:pilot --workspace @certpath/web",
    "dry-run:pilot": "npm run dry-run:pilot --workspace @certpath/web",
    "deploy:staging": "npm run deploy:staging --workspace @certpath/web",
    "dry-run:staging": "npm run dry-run:staging --workspace @certpath/web",
    "learner:provision": "node apps/api/scripts/provision-learner-sign-in-invite.mjs",
    "staff:provision": "tsx apps/api/scripts/provision-staff-accounts.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tools/cissp-convert/tsconfig.json && tsc --noEmit -p tools/cissp-import-driver/tsconfig.json",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "test:tools": "tsx --test tools/cissp-convert/cli.test.ts tools/cissp-import-driver/contract.test.ts tools/cissp-import-driver/transform.test.ts tools/cissp-import-driver/validate.test.ts tools/cissp-import-driver/checkpoint.test.ts tools/cissp-import-driver/decide.test.ts tools/cissp-import-driver/client.test.ts tools/cissp-import-driver/run.test.ts tools/cissp-import-driver/cli.test.ts",
    "check:isolation": "node apps/web/scripts/check-d1-isolation.mjs",
    "db:export": "node apps/web/scripts/d1-export.mjs",
    "db:rehearse": "node apps/web/scripts/d1-restore-rehearse.mjs",
    "db:preflight": "node apps/web/scripts/d1-account-preflight.mjs",
    "db:chain": "node apps/web/scripts/d1-chain-check.mjs",
    "db:migrate:local": "npm run db:migrate:local --workspace @certpath/web",
    "benchmark:lambda:package": "npm run benchmark:lambda:package --workspace @certpath/api",
    "benchmark:lambda": "npm run benchmark:lambda --workspace @certpath/api",
    "verify": "npm run check:isolation && npm run typecheck && npm test && npm run db:chain && npm run build"
  }
}
